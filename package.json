{
  "name": "markdown-mcp-resource",
  "version": "1.1.0",
  "description": "MCP server that makes remote markdown files available as mcp resources",
  "keywords": [
    "markdown",
    "mcp-server"
  ],
  "homepage": "https://github.com/pawcoding/markdown-mcp-resource",
  "bugs": {
    "url": "https://github.com/pawcoding/markdown-mcp-resource/issues"
  },
  "license": "MIT",
  "author": "Luis Wolf <development@pawcode.de> (https://pawcode.de)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawcoding/markdown-mcp-resource.git"
  },
  "bin": "dist/index.mjs",
  "files": [
    "dist/index.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "postbuild": "npm run generate:schema",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:schema": "tsx build/export-schema.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.mjs $MARKDOWN_MCP_RESOURCE"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "oxfmt": "0.59.0",
    "tsdown": "0.22.9",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
