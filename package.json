{
  "name": "markdown-mcp-resource",
  "version": "1.2.2",
  "description": "MCP server that makes remote markdown files available as mcp resources",
  "keywords": [
    "markdown",
    "mcp-server"
  ],
  "homepage": "https://github.com/pawcoding/markdown-mcp-resource",
  "bugs": {
    "url": "https://github.com/pawcoding/markdown-mcp-resource/issues"
  },
  "license": "MIT",
  "author": "Luis Wolf <development@pawcode.de> (https://pawcode.de)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawcoding/markdown-mcp-resource.git"
  },
  "bin": {
    "markdown-mcp-resource": "dist/index.mjs"
  },
  "files": [
    "dist/index.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "tsdown",
    "postbuild": "npm run generate:schema",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:schema": "oxnode build/export-schema.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.mjs $MARKDOWN_MCP_RESOURCE",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@oxc-node/cli": "1.0.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "tsdown": "0.23.4",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.1"
}
