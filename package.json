{
  "name": "markdown-mcp-resource",
  "version": "1.2.0",
  "description": "MCP server that makes remote markdown files available as mcp resources",
  "keywords": [
    "markdown",
    "mcp-server"
  ],
  "homepage": "https://github.com/pawcoding/markdown-mcp-resource",
  "bugs": {
    "url": "https://github.com/pawcoding/markdown-mcp-resource/issues"
  },
  "license": "MIT",
  "author": "Luis Wolf <development@pawcode.de> (https://pawcode.de)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawcoding/markdown-mcp-resource.git"
  },
  "bin": {
    "markdown-mcp-resource": "dist/index.mjs"
  },
  "files": [
    "dist/index.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "npm run typecheck",
    "build": "tsdown",
    "postbuild": "npm run generate:schema",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:schema": "tsdown build/export-schema.ts -d ./build --no-config --no-clean --no-report --log-level error --on-success \"node build/export-schema.mjs\"",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.mjs $MARKDOWN_MCP_RESOURCE",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.0"
}
