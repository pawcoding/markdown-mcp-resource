{
  "name": "markdown-mcp-resource",
  "version": "1.0.2",
  "description": "MCP server that makes remote markdown files available as mcp resources",
  "keywords": [
    "markdown",
    "mcp-server"
  ],
  "homepage": "https://github.com/pawcoding/markdown-mcp-resource",
  "bugs": {
    "url": "https://github.com/pawcoding/markdown-mcp-resource/issues"
  },
  "license": "MIT",
  "author": "Luis Wolf <development@pawcode.de> (https://pawcode.de)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawcoding/markdown-mcp-resource.git"
  },
  "bin": "dist/index.mjs",
  "files": [
    "dist/index.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "postbuild": "npm run generate:schema",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:schema": "tsx build/export-schema.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.mjs $MARKDOWN_MCP_RESOURCE"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.50.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.14.1"
}
