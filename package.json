{
  "name": "markdown-mcp-resource",
  "version": "1.0.1",
  "description": "MCP server that makes remote markdown files available as mcp resources",
  "keywords": [
    "mcp-server",
    "markdown"
  ],
  "homepage": "https://github.com/pawcoding/markdown-mcp-resource",
  "bugs": {
    "url": "https://github.com/pawcoding/markdown-mcp-resource/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawcoding/markdown-mcp-resource.git"
  },
  "license": "MIT",
  "author": "Luis Wolf <development@pawcode.de> (https://pawcode.de)",
  "type": "module",
  "bin": "dist/index.js",
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "node build/bundle.js",
    "postbuild": "npm run generate:schema",
    "clean": "rm -rf dist",
    "dev": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" --watch --external:@modelcontextprotocol/sdk",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "generate:schema": "tsx build/export-schema.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart": "npm run build",
    "start": "node dist/index.js $MARKDOWN_MCP_RESOURCE"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^24.8.1",
    "esbuild": "^0.25.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.14.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
