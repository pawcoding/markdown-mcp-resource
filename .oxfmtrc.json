{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "printWidth": 80,
  "sortPackageJson": {},
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "dist/",
    "CHANGELOG.md",
    "schema.json",
    "node_modules/",
    "npm-debug.log*",
    ".env",
    ".env.production",
    ".DS_Store",
    ".idea/",
    "LICENSE",
    ".husky/",
    ".gitignore",
    ".nvmrc",
    "docs/plans/"
  ]
}
